# TMDB (data source untuk semua katalog)
VITE_TMDB_URL=https://api.themoviedb.org/3
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_IMAGE_URL=https://image.tmdb.org/t/p/w500

# Custom backend (auth/order/payment/profile/admin) — belum dikembangkan
VITE_API_URL=http://localhost:8800
VITE_API_IMAGE_URL=http://localhost:8800/uploads

# Aktifkan mock adapter (dev-only, tanpa backend). true/false
VITE_ENABLE_MOCKS=true
